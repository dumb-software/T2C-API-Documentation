":[],"headers":[{"name":"Access-Control-Allow-Credentials","value":"true"},{"name":"Access-Control-Allow-Origin","value":"http://localhost:4200"},{"name":"Content-Encoding","value":"gzip"},{"name":"Content-Type","value":"application/json; charset=utf-8"},{"name":"Date","value":"Wed, 18 Mar 2026 13:25:30 GMT"},{"name":"Etag","value":"W/\"6d31-dU4IABBBLHcRwzAXJWs4j+lXTY8\""},{"name":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"name":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains; preload"},{"name":"Vary","value":"Accept-Encoding"},{"name":"Vary","value":"Origin"},{"name":"X-Cache","value":"HIT"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-Frame-Options","value":"ALLOW-FROM https://connexion.t2c.fr"},{"name":"X-Xss-Protection","value":"1; mode=block"},{"name":"Transfer-Encoding","value":"chunked"}],"content":{"size":27953,"mimeType":"application/json","text":"[{\"id\":\"1.21924.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Alice Milliat reporté jusqu'au 29 mai 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Alice Milliat</strong> en direction de DURTOL Clinique est reporté sur l'arrêt Av. de l'Allier, situé avenue de l'Allier jusqu'au <u>vendredi 29 mai 2026</u>.</p>\",\"start_datetime\":\"2025-12-20T03:39:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"C\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-20T03:42:02.692Z\",\"updated_at\":\"2026-02-25T14:25:54.000Z\"},{\"id\":\"1.32271.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Roches Brunes\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Roches Brunes</strong> en direction de Trémonteix Charcot sera reporté <u>du lundi 16 mars au vendredi 20 mars 2026</u> sur un arrêt provisoire situé au niveau du n° 38 de l'avenue de la Libération.</p>\",\"start_datetime\":\"2026-03-09T08:19:24.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-09T08:30:03.552Z\",\"updated_at\":\"2026-03-09T08:29:18.000Z\"},{\"id\":\"1.32091.2\",\"type\":\"Trafic\",\"title\":\"Ligne E2 à compter du 27 janvier 2026\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne E2 seront déviés dans les deux sens, <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Esplanade </strong>seront reportés sur les arrêts Carnot de la ligne B, situés avenue Carnot<strong>.</strong></li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Delille Salford et Michel de l'Hospital </strong>seront reportés sur les arrêts Faculté de la ligne B, situés avenue Carnot.</li></ol><p><br></p><p>Pour vous rendre à Delille Salford, vous pouvez emprunter la ligne E1.</p><p>Pour vous rendre à Michel de l'Hospital, vous pouvez emprunter la ligne S14.</p><p>Pour consulter le plan de la ligne E2 valable pendant la déviation, cliquez <a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20E2%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></p>\",\"start_datetime\":\"2026-01-23T09:03:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:04:02.104Z\",\"updated_at\":\"2026-02-04T14:48:58.000Z\"},{\"id\":\"1.21908.2\",\"type\":\"Trafic\",\"title\":\"Déviation de la ligne E2 jusqu'au 3 avril 2026 (secteur Beaumont)\",\"text\":\"<p>En raison de travaux avenue du Mont Dore à Beaumont, les bus de la ligne E2 en direction de CEYRAT Libération sont déviés <u>jusqu'au vendredi 3 avril 2026</u> :</p><ol><li data-list=\\\"bullet\\\" class=\\\"ql-align-justify\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>L’arrêt <strong>Chapelle de l’Agneau</strong> est reporté sur l’arrêt Chaussades de la ligne P31 direction CEYRAT Arténium, situé rue de Montpoly.</li><li data-list=\\\"bullet\\\" class=\\\"ql-align-justify\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>L’arrêt <strong>Les Roches</strong> est reporté sur l’arrêt Châtaigneraie de la ligne P31 direction CEYRAT Arténium, situé rue du Matharet.</li><li data-list=\\\"bullet\\\" class=\\\"ql-align-justify\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>BEAUMONT Pont de Boissejour* et Matharet</strong> seront reportés sur l’arrêt MATUSSAT Châtaigneraie de la ligne P31 situé rue du Matharet.</li></ol><p class=\\\"ql-align-justify\\\"><br></p><p class=\\\"ql-align-justify\\\"><br></p><p class=\\\"ql-align-justify\\\"><strong>* </strong><strong style=\\\"color: rgb(230, 0, 0);\\\">IMPORTANT</strong><span style=\\\"color: rgb(230, 0, 0);\\\"> </span><strong>:</strong> <strong>les bus ayant pour terminus BEAUMONT Pt de Boisséjour effectuent la desserte de l'arrêt BEAUMONT Pt de Boisséjour de la ligne E2 direction Trémonteix Charcot. </strong></p><p class=\\\"ql-align-justify\\\"><br></p>\",\"start_datetime\":\"2025-12-19T06:32:27.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-02-17T17:43:53.000Z\"},{\"id\":\"1.21905.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Beaumont Pont de Boisséjour reporté jusqu'au 3 avril 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>BEAUMONT Pont de Boisséjour</strong> en direction de Trémonteix Charcot sera reporté sur l'arrêt de régulation situé juste avant, jusqu'au <u>vendredi 3 avril 2026</u>.</p>\",\"start_datetime\":\"2025-12-19T06:15:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2025-12-20T15:14:00.000Z\"},{\"id\":\"1.21887.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Les Roches direction Trémonteix Charcot reporté jusqu'au 3 avril 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Les Roches</strong> en direction de Trémonteix Charcot sera reporté sur l'arrêt Chapelle de l'Agneau jusqu'au <u>vendredi 3 avril 2026</u>.</p>\",\"start_datetime\":\"2025-12-18T07:33:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-18T13:42:04.994Z\",\"updated_at\":\"2025-12-20T03:50:59.000Z\"},{\"id\":\"1.32165.2\",\"type\":\"Trafic\",\"title\":\"Arrêt L'Hermitage reporté\",\"text\":\"<p><u>A compter du mercredi 11 février</u>, en raison de travaux bd Gustave Flaubert, l'arrêt <strong>L'Hermitage </strong>direction Lycée Lafayette sera reporté sur 1 arrêt provisoire situé 100 mètres avant.</p>\",\"start_datetime\":\"2026-02-06T15:16:12.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"21\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-06T15:19:02.170Z\",\"updated_at\":\"2026-02-17T12:19:23.000Z\"},{\"id\":\"1.21919.8\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne E3 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction Lycée La Fayette seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction CEBAZAT CHU L. Michel seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Coutils </strong>seront reportés dans les 2 sens sur des arrêts provisoires* situés avenue du 8 Mai, à hauteur du carrefour avec la rue et la Route de Gerzat.</li></ol><p><span style=\\\"color: rgb(255, 255, 255);\\\"> </span><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"21\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.32220.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Grassette\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Grassette </strong>en direction de Lempdes La Rochelle sera reporté sur un arrêt provisoire situé en début de quai <u>du lundi 2 au vendredi 20 mars 2026.</u></p><p><br></p><p><br></p>\",\"start_datetime\":\"2026-02-23T09:15:25.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"9\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-23T09:20:02.762Z\",\"updated_at\":\"2026-02-23T09:19:04.000Z\"},{\"id\":\"1.32320.2\",\"type\":\"Trafic\",\"title\":\"Déviation place Claude Wolff du 23 au 27 mars\",\"text\":\"<p>En raison de travaux, les bus en direction de PERIGNAT Les Horts seront déviés <u>du lundi 23 au vendredi 27 mars</u>. Les arrêts <strong>Chamalières Mairie</strong> et <strong>Parc Montjoly</strong> seront reportés sur l'arrêt Montjoly de la ligne E7 du dimanche en direction de ROYAT AvanC-Breuil, situé 4 avenue Paul Bert.</p>\",\"start_datetime\":\"2026-03-16T10:00:08.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"13\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-16T10:05:02.842Z\",\"updated_at\":\"2026-03-16T10:04:20.000Z\"},{\"id\":\"1.32092.2\",\"type\":\"Trafic\",\"title\":\"Déviation ligne S10 direction Hauts de Chamalières\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne S10 en direction des Hauts de CHAMALIERES seront déviés du lundi au samedi <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>L'arrêt <strong>Pont de Naud </strong>sera reporté sur l'arrêt provisoire Pont de Naud bis, situé 57 bd Lafayette.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les <strong>Carnot et Faculté</strong> seront reportés sur l'arrêt provisoire Barrière d'Issoire bis, situé 23 bd Lafayette.</li></ol><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Pour consulter le plan de la ligne S10 valable pendant la déviation, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20S10%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u></p>\",\"start_datetime\":\"2026-01-23T09:04:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"13\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:05:02.678Z\",\"updated_at\":\"2026-01-31T09:45:44.000Z\"},{\"id\":\"1.32204.5\",\"type\":\"Trafic\",\"title\":\"Arrêts Arsenal\",\"text\":\"<p>En raison de travaux, <u>du lundi 16 février au jeudi 30 avril 2026,</u> les arrêts <strong>Arsenal</strong> dans les deux sens seront reportés 10 mètres après le rond-point bd Georges Pompidou.</p>\",\"start_datetime\":\"2026-02-16T15:23:18.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"10\",\"10\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T16:06:02.444Z\",\"updated_at\":\"2026-02-16T16:05:14.000Z\"},{\"id\":\"1.32093.2\",\"type\":\"Trafic\",\"title\":\"Déviation de la ligne S12\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne S12 seront déviés dans les deux sens du lundi au samedi, <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Gare SNCF et Esplanade </strong>seront reportés sur les arrêts Carnot de la ligne B, situés avenue Carnot.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Delille Salford et Michel de l'Hospital</strong> seront reporté sur les arrêts Faculté de la ligne B, situés avenue Carnot.</li></ol><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Pour consulter le plan de la ligne S12 valable pendant la déviation, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20S12%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u></p>\",\"start_datetime\":\"2026-01-31T09:48:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"8\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:07:02.126Z\",\"updated_at\":\"2026-01-31T09:48:55.000Z\"},{\"id\":\"1.21919.11\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne S13 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction Champratel seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction BLANZAT Clos St Vincent seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Coutils </strong>seront reportés dans les 2 sens sur des arrêts provisoires* situés avenue du 8 Mai, à hauteur du carrefour avec la rue et la Route de Gerzat.</li></ol><p><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"24\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.32203.2\",\"type\":\"Trafic\",\"title\":\"Ligne déviée direction AULNAT St Exupéry jusqu'au 18 mars 2026\",\"text\":\"<p>En raison de travaux, la ligne S14 direction AULNAT St Exupéry sera déviée <u>jusqu'au mercredi 18 mars 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts Résistance et BEAUMONT Pl. d'Armes seront reportés sur l'arrêt Résistance de la ligne P39 direction CHU G. Montpied, situé route de Romagnat</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>l'arrêt René Brut sera reporté sur l'arrêt Croix Neuve</li></ol>\",\"start_datetime\":\"2026-03-18T09:10:00.000Z\",\"end_datetime\":\"2026-03-18T22:59:00.000Z\",\"priority\":1,\"affected_routes\":[\"12\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T09:27:02.212Z\",\"updated_at\":\"2026-03-18T10:00:31.000Z\"},{\"id\":\"1.32204.2\",\"type\":\"Trafic\",\"title\":\"Arrêts Arsenal\",\"text\":\"<p>En raison de travaux, <u>du lundi 16 février au jeudi 30 avril 2026, l</u>es arrêts <strong>Arsenal</strong> dans les deux sens seront reportés 10 mètres après le rond-point bd Louis Chartoire.</p>\",\"start_datetime\":\"2026-02-16T15:23:18.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"12\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T15:32:02.660Z\",\"updated_at\":\"2026-02-16T16:05:14.000Z\"},{\"id\":\"1.32164.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Emile Coulaudon reporté\",\"text\":\"<p><u>Du mardi 10 février au vendredi 3 avril</u>, en raison de travaux av de Clermont, l'arrêt <strong>Emile Coulaudon </strong>direction Lycée Lafayette sera reporté sur 1 arrêt provisoire situé 25 mètres après le rond-point.</p>\",\"start_datetime\":\"2026-02-06T15:10:12.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"23\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-06T15:15:03.022Z\",\"updated_at\":\"2026-03-09T09:07:54.000Z\"},{\"id\":\"1.32094.2\",\"type\":\"Trafic\",\"title\":\"Ligne S15\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne S15 effectueront leur terminus à l'arrêt AUBIERE Quartier Chambon de la ligne S10 <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Roussillon, Gustave Flaubert, Patinoire et Lycée La Fayette</strong> ne seront pas desservis en direction de Lycée La Fayette du lundi au samedi.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Lycée La Fayette, Patinoire et Gustave Flaubert </strong>ne seront pas desservis en direction de COURNON Plan d'eau du lundi au samedi.</li></ol><p><br></p><p><strong><u>Important :</u></strong></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Pour rejoindre l'arrêt Lycée La Fayette, vous pouvez emprunter la ligne C depuis l'arrêt Pont de Sarliève.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Pour rejoindre l'arrêt Lycée Gustave Flaubert, vous pouvez emprunter la ligne S10.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Pour rejoindre l'arrêt Roussillon, vous pouvez emprunter la ligne S10 depuis l'arrêt AUBIERE Quartier Chambon ou vous pouvez vous reporter à l'arrêt Chazots de la ligne S15.</li></ol><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Pour consulter le plan de la ligne S15 valable pendant la déviation, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20S15%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u></p>\",\"start_datetime\":\"2026-01-23T09:07:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"23\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:07:02.126Z\",\"updated_at\":\"2026-01-31T09:51:07.000Z\"},{\"id\":\"1.21903.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Alice Milliat reporté jusqu'au 29 mai 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Alice Milliat</strong> en direction de Lycée La Fayette est reporté sur l'arrêt Av. de l'Allier, situé avenue de l'Allier, jusqu'au <u>vendredi 29 mai 2026</u>.</p>\",\"start_datetime\":\"2025-12-19T05:50:15.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"23\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T05:53:02.105Z\",\"updated_at\":\"2026-02-25T14:28:44.000Z\"},{\"id\":\"1.32202.2\",\"type\":\"Trafic\",\"title\":\"Déviation du 23 février au 27 mars 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne P31 seront déviés dans les deux sens <u>du lundi 23 février au vendredi 27 mars 2026</u> :</p><p><u>Direction CEYRAT Arténium :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts <strong>Résistance</strong>, <strong>Bernard Maître </strong>et <strong>Champ Madame</strong> seront reportés sur les arrêts Résistance de la ligne S12 direction BEAUMONT Pl. d'Armes.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts<strong> Chapelle de l'Agneau</strong>,<strong> Stade de l'Artière </strong>et<strong> Prés Hauts </strong>seront reportés sur les arrêts Chaussades.</li></ol><p><u>Direction BEAUMONT Collège Molière :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts <strong>Bernard Maître </strong>et <strong>Champ Madame</strong> seront reportés sur les arrêts BEAUMONT Pl. d'Armes.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts<strong> Stade de l'Artière </strong>et<strong> Prés Hauts </strong>seront reportés sur les arrêts Les Roches.</li></ol><p><span style=\\\"color: rgb(26, 27, 31);\\\">Pour consulter le plan de la ligne P31 pendant ces travaux, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/SMTC_T2C_PL_P31_100pct_dec2025_v03.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u><span style=\\\"color: rgb(26, 27, 31);\\\">.</span></p>\",\"start_datetime\":\"2026-02-16T08:38:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"42\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T08:47:02.404Z\",\"updated_at\":\"2026-02-18T15:49:36.000Z\"},{\"id\":\"1.21919.14\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne P33 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction Champratel seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction CHATEAUGAY Malalittes seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Coutils </strong>seront reportés dans les 2 sens sur des arrêts provisoires* situés avenue du 8 Mai, à hauteur du carrefour avec la rue et la Route de Gerzat.</li></ol><p><span style=\\\"color: rgb(255, 255, 255);\\\"> </span><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"31\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.32272.2\",\"type\":\"Trafic\",\"title\":\"Déviation ligne P34\",\"text\":\"<p>En raison de travaux, les bus de la ligne P34 seront déviés dans les deux sens <u>du lundi 16 au vendredi 20 mars </u>: </p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>l'arrêt <strong>Victor Charreton</strong> en direction des Côtes sera reporté sur l'arrêt de descente Trémonteix Paul Eychart de la ligne E4, situé pl. Paul Eychart.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>l'arrêt <strong>Victor Charreton</strong> en direction de Tillon sera reporté sur le terminus Paul Eychart de la ligne E4 situé rue Jean Monnet.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Jacques Brel</strong> seront reportés sur les arrêts Trémonteix Charcot de la ligne E4, situés rue Jean Monnet. </li></ol>\",\"start_datetime\":\"2026-03-09T09:20:48.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"7\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-10T10:58:03.005Z\",\"updated_at\":\"2026-03-10T10:57:24.000Z\"},{\"id\":\"1.32255.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Lac direction Le Cendre Pandières reporté définitivement\",\"text\":\"<p>L'arrêt <strong>Lac </strong>direction Le Cendre Pandières sera reporté définitivement <u>à compter du mardi 3 mars 2026</u> sur l'arrêt Dômes, situé avenue G. Clémenceau.</p>\",\"start_datetime\":\"2026-03-02T07:58:46.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"34\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-02T08:01:02.685Z\",\"updated_at\":\"2026-03-02T08:00:58.000Z\"},{\"id\":\"1.21919.2\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne P37 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Coutils</strong>,<strong> Champcros </strong>et <strong>Debussy</strong> direction Champratel/Gare SNCF seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Coutils</strong>,<strong> Champcros </strong>et <strong>Debussy</strong> direction GERZAT Donnavignat seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li></ol><p><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"28\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.21927.2\",\"type\":\"Trafic\",\"title\":\"Ligne BEN déviée jusqu'au 7 juin 2026\",\"text\":\"<p>En raison de travaux, les bus BEN sont déviés jusqu'au <u>samedi 7 juin 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Résidence Pasteur </strong>et<strong> Cité 1</strong> sont reportés sur l’arrêt de substitution Cézeaux Pellez* de la ligne A direction La Pardieu Gare, situé situé avenue Blaise Pascal, au niveau de la station tram.</li></ol><p><br></p><p><strong>* </strong>Arrêt non accessible aux personnes à mobilité réduite</p>\",\"start_datetime\":\"2025-12-20T04:31:30.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L34\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-20T04:37:01.947Z\",\"updated_at\":\"2025-12-22T09:17:44.000Z\"},{\"id\":\"1.32260.2\",\"type\":\"Trafic\",\"title\":\"Ligne 110 - Collège Anatole France\",\"text\":\"<p><u>À compter du lundi 9 mars</u>, le départ de 7h27 de l’arrêt <strong>BLANZAT Fradière</strong> en direction du collège Anatole France, sera réalisé depuis l'arrêt Fradière de la ligne S13 direction Champratel, situé place de la Poste.</p><p><br></p><p><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-03/Collège%20Anatole%20France.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">Consultez la fiche horaires valable à compter du lundi 9 mars</a></p>\",\"start_datetime\":\"2026-03-05T07:31:14.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L36\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-05T07:32:02.287Z\",\"updated_at\":\"2026-03-09T05:35:46.000Z\"},{\"id\":\"1.21919.5\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne scolaire 110 pour le collège Anatole France seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u>.</p><p>Les arrêts Coutils, Champcros et Debussy sont reportés sur un poteau provisoire* situé au niveau du n° 51 avenue de la République.</p><p>*Arrêts provisoires non accessibles aux personnes à mobilité réduite</p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L36\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.21916.2\",\"type\":\"Trafic\",\"title\":\"Déviation des services scolaires S160 du 5 janvier au 3 avril 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne scolaire BEAUMONT Chemin de Sou - Collège Molière (S160) et Collège Molière - BEAUMONT Matharet (S160) seront déviés <u>jusqu'au vendredi 3 avril 2026. </u></p><p><a href=\\\"https://api.t2c.fr/sites/default/files/2026-01/Servicesscolaires_Moliere.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">Consultez la nouvelle feuille de route de la ligne</a></p>\",\"start_datetime\":\"2025-12-19T08:02:57.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L41\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-01-28T12:25:28.000Z\"}]"},"redirectURL":"","headersSize":566,"bodySize":4887,"_status":"completed","_startTimestamp":1773840330164314,"_endTimestamp":1773840330168035},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"51.210.165.22","connection":"59","comment":"","_id":45,"_uid":"16b8d239-a24d-48fd-b254-c08364a6dfba","_cid":59,"_ctime":1773840330025,"_sid":1,"_stime":1773840330107,"_serverAddress":"51.210.165.22","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"192.168.1.157","_clientAddressFamily":0,"_clientPort":45874,"_highlight":1,"_app":{"name":"T2C","id":"fr.t2c.t2c"}},{"startedDateTime":"2026-03-18T13:26:29.451Z","time":62,"request":{"method":"GET","url":"https://api.t2c.fr/siv/alerts?type=Trafic","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"user-agent","value":"Dart/3.10 (dart:io)"},{"name":"accept-encoding","value":"gzip"},{"name":"host","value":"api.t2c.fr"}],"queryString":[{"name":"type","value":"Trafic"}],"headersSize":74,"bodySize":0,"_status":"completed","_startTimestamp":1773840389451154,"_endTimestamp":1773840389451830},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Credentials","value":"true"},{"name":"Access-Control-Allow-Origin","value":"http://localhost:4200"},{"name":"Content-Encoding","value":"gzip"},{"name":"Content-Type","value":"application/json; charset=utf-8"},{"name":"Date","value":"Wed, 18 Mar 2026 13:26:29 GMT"},{"name":"Etag","value":"W/\"6d31-dU4IABBBLHcRwzAXJWs4j+lXTY8\""},{"name":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"name":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains; preload"},{"name":"Vary","value":"Accept-Encoding"},{"name":"Vary","value":"Origin"},{"name":"X-Cache","value":"HIT"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-Frame-Options","value":"ALLOW-FROM https://connexion.t2c.fr"},{"name":"X-Xss-Protection","value":"1; mode=block"},{"name":"Transfer-Encoding","value":"chunked"}],"content":{"size":27953,"mimeType":"application/json","text":"[{\"id\":\"1.21924.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Alice Milliat reporté jusqu'au 29 mai 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Alice Milliat</strong> en direction de DURTOL Clinique est reporté sur l'arrêt Av. de l'Allier, situé avenue de l'Allier jusqu'au <u>vendredi 29 mai 2026</u>.</p>\",\"start_datetime\":\"2025-12-20T03:39:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"C\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-20T03:42:02.692Z\",\"updated_at\":\"2026-02-25T14:25:54.000Z\"},{\"id\":\"1.32271.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Roches Brunes\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Roches Brunes</strong> en direction de Trémonteix Charcot sera reporté <u>du lundi 16 mars au vendredi 20 mars 2026</u> sur un arrêt provisoire situé au niveau du n° 38 de l'avenue de la Libération.</p>\",\"start_datetime\":\"2026-03-09T08:19:24.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-09T08:30:03.552Z\",\"updated_at\":\"2026-03-09T08:29:18.000Z\"},{\"id\":\"1.32091.2\",\"type\":\"Trafic\",\"title\":\"Ligne E2 à compter du 27 janvier 2026\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne E2 seront déviés dans les deux sens, <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Esplanade </strong>seront reportés sur les arrêts Carnot de la ligne B, situés avenue Carnot<strong>.</strong></li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Delille Salford et Michel de l'Hospital </strong>seront reportés sur les arrêts Faculté de la ligne B, situés avenue Carnot.</li></ol><p><br></p><p>Pour vous rendre à Delille Salford, vous pouvez emprunter la ligne E1.</p><p>Pour vous rendre à Michel de l'Hospital, vous pouvez emprunter la ligne S14.</p><p>Pour consulter le plan de la ligne E2 valable pendant la déviation, cliquez <a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20E2%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></p>\",\"start_datetime\":\"2026-01-23T09:03:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:04:02.104Z\",\"updated_at\":\"2026-02-04T14:48:58.000Z\"},{\"id\":\"1.21908.2\",\"type\":\"Trafic\",\"title\":\"Déviation de la ligne E2 jusqu'au 3 avril 2026 (secteur Beaumont)\",\"text\":\"<p>En raison de travaux avenue du Mont Dore à Beaumont, les bus de la ligne E2 en direction de CEYRAT Libération sont déviés <u>jusqu'au vendredi 3 avril 2026</u> :</p><ol><li data-list=\\\"bullet\\\" class=\\\"ql-align-justify\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>L’arrêt <strong>Chapelle de l’Agneau</strong> est reporté sur l’arrêt Chaussades de la ligne P31 direction CEYRAT Arténium, situé rue de Montpoly.</li><li data-list=\\\"bullet\\\" class=\\\"ql-align-justify\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>L’arrêt <strong>Les Roches</strong> est reporté sur l’arrêt Châtaigneraie de la ligne P31 direction CEYRAT Arténium, situé rue du Matharet.</li><li data-list=\\\"bullet\\\" class=\\\"ql-align-justify\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>BEAUMONT Pont de Boissejour* et Matharet</strong> seront reportés sur l’arrêt MATUSSAT Châtaigneraie de la ligne P31 situé rue du Matharet.</li></ol><p class=\\\"ql-align-justify\\\"><br></p><p class=\\\"ql-align-justify\\\"><br></p><p class=\\\"ql-align-justify\\\"><strong>* </strong><strong style=\\\"color: rgb(230, 0, 0);\\\">IMPORTANT</strong><span style=\\\"color: rgb(230, 0, 0);\\\"> </span><strong>:</strong> <strong>les bus ayant pour terminus BEAUMONT Pt de Boisséjour effectuent la desserte de l'arrêt BEAUMONT Pt de Boisséjour de la ligne E2 direction Trémonteix Charcot. </strong></p><p class=\\\"ql-align-justify\\\"><br></p>\",\"start_datetime\":\"2025-12-19T06:32:27.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-02-17T17:43:53.000Z\"},{\"id\":\"1.21905.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Beaumont Pont de Boisséjour reporté jusqu'au 3 avril 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>BEAUMONT Pont de Boisséjour</strong> en direction de Trémonteix Charcot sera reporté sur l'arrêt de régulation situé juste avant, jusqu'au <u>vendredi 3 avril 2026</u>.</p>\",\"start_datetime\":\"2025-12-19T06:15:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2025-12-20T15:14:00.000Z\"},{\"id\":\"1.21887.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Les Roches direction Trémonteix Charcot reporté jusqu'au 3 avril 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Les Roches</strong> en direction de Trémonteix Charcot sera reporté sur l'arrêt Chapelle de l'Agneau jusqu'au <u>vendredi 3 avril 2026</u>.</p>\",\"start_datetime\":\"2025-12-18T07:33:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"4\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-18T13:42:04.994Z\",\"updated_at\":\"2025-12-20T03:50:59.000Z\"},{\"id\":\"1.32165.2\",\"type\":\"Trafic\",\"title\":\"Arrêt L'Hermitage reporté\",\"text\":\"<p><u>A compter du mercredi 11 février</u>, en raison de travaux bd Gustave Flaubert, l'arrêt <strong>L'Hermitage </strong>direction Lycée Lafayette sera reporté sur 1 arrêt provisoire situé 100 mètres avant.</p>\",\"start_datetime\":\"2026-02-06T15:16:12.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"21\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-06T15:19:02.170Z\",\"updated_at\":\"2026-02-17T12:19:23.000Z\"},{\"id\":\"1.21919.8\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne E3 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction Lycée La Fayette seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction CEBAZAT CHU L. Michel seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Coutils </strong>seront reportés dans les 2 sens sur des arrêts provisoires* situés avenue du 8 Mai, à hauteur du carrefour avec la rue et la Route de Gerzat.</li></ol><p><span style=\\\"color: rgb(255, 255, 255);\\\"> </span><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"21\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.32220.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Grassette\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Grassette </strong>en direction de Lempdes La Rochelle sera reporté sur un arrêt provisoire situé en début de quai <u>du lundi 2 au vendredi 20 mars 2026.</u></p><p><br></p><p><br></p>\",\"start_datetime\":\"2026-02-23T09:15:25.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"9\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-23T09:20:02.762Z\",\"updated_at\":\"2026-02-23T09:19:04.000Z\"},{\"id\":\"1.32320.2\",\"type\":\"Trafic\",\"title\":\"Déviation place Claude Wolff du 23 au 27 mars\",\"text\":\"<p>En raison de travaux, les bus en direction de PERIGNAT Les Horts seront déviés <u>du lundi 23 au vendredi 27 mars</u>. Les arrêts <strong>Chamalières Mairie</strong> et <strong>Parc Montjoly</strong> seront reportés sur l'arrêt Montjoly de la ligne E7 du dimanche en direction de ROYAT AvanC-Breuil, situé 4 avenue Paul Bert.</p>\",\"start_datetime\":\"2026-03-16T10:00:08.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"13\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-16T10:05:02.842Z\",\"updated_at\":\"2026-03-16T10:04:20.000Z\"},{\"id\":\"1.32092.2\",\"type\":\"Trafic\",\"title\":\"Déviation ligne S10 direction Hauts de Chamalières\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne S10 en direction des Hauts de CHAMALIERES seront déviés du lundi au samedi <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>L'arrêt <strong>Pont de Naud </strong>sera reporté sur l'arrêt provisoire Pont de Naud bis, situé 57 bd Lafayette.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les <strong>Carnot et Faculté</strong> seront reportés sur l'arrêt provisoire Barrière d'Issoire bis, situé 23 bd Lafayette.</li></ol><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Pour consulter le plan de la ligne S10 valable pendant la déviation, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20S10%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u></p>\",\"start_datetime\":\"2026-01-23T09:04:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"13\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:05:02.678Z\",\"updated_at\":\"2026-01-31T09:45:44.000Z\"},{\"id\":\"1.32204.5\",\"type\":\"Trafic\",\"title\":\"Arrêts Arsenal\",\"text\":\"<p>En raison de travaux, <u>du lundi 16 février au jeudi 30 avril 2026,</u> les arrêts <strong>Arsenal</strong> dans les deux sens seront reportés 10 mètres après le rond-point bd Georges Pompidou.</p>\",\"start_datetime\":\"2026-02-16T15:23:18.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"10\",\"10\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T16:06:02.444Z\",\"updated_at\":\"2026-02-16T16:05:14.000Z\"},{\"id\":\"1.32093.2\",\"type\":\"Trafic\",\"title\":\"Déviation de la ligne S12\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne S12 seront déviés dans les deux sens du lundi au samedi, <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Gare SNCF et Esplanade </strong>seront reportés sur les arrêts Carnot de la ligne B, situés avenue Carnot.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Delille Salford et Michel de l'Hospital</strong> seront reporté sur les arrêts Faculté de la ligne B, situés avenue Carnot.</li></ol><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Pour consulter le plan de la ligne S12 valable pendant la déviation, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20S12%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u></p>\",\"start_datetime\":\"2026-01-31T09:48:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"8\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:07:02.126Z\",\"updated_at\":\"2026-01-31T09:48:55.000Z\"},{\"id\":\"1.21919.11\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne S13 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction Champratel seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction BLANZAT Clos St Vincent seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Coutils </strong>seront reportés dans les 2 sens sur des arrêts provisoires* situés avenue du 8 Mai, à hauteur du carrefour avec la rue et la Route de Gerzat.</li></ol><p><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"24\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.32203.2\",\"type\":\"Trafic\",\"title\":\"Ligne déviée direction AULNAT St Exupéry jusqu'au 18 mars 2026\",\"text\":\"<p>En raison de travaux, la ligne S14 direction AULNAT St Exupéry sera déviée <u>jusqu'au mercredi 18 mars 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts Résistance et BEAUMONT Pl. d'Armes seront reportés sur l'arrêt Résistance de la ligne P39 direction CHU G. Montpied, situé route de Romagnat</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>l'arrêt René Brut sera reporté sur l'arrêt Croix Neuve</li></ol>\",\"start_datetime\":\"2026-03-18T09:10:00.000Z\",\"end_datetime\":\"2026-03-18T22:59:00.000Z\",\"priority\":1,\"affected_routes\":[\"12\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T09:27:02.212Z\",\"updated_at\":\"2026-03-18T10:00:31.000Z\"},{\"id\":\"1.32204.2\",\"type\":\"Trafic\",\"title\":\"Arrêts Arsenal\",\"text\":\"<p>En raison de travaux, <u>du lundi 16 février au jeudi 30 avril 2026, l</u>es arrêts <strong>Arsenal</strong> dans les deux sens seront reportés 10 mètres après le rond-point bd Louis Chartoire.</p>\",\"start_datetime\":\"2026-02-16T15:23:18.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"12\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T15:32:02.660Z\",\"updated_at\":\"2026-02-16T16:05:14.000Z\"},{\"id\":\"1.32164.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Emile Coulaudon reporté\",\"text\":\"<p><u>Du mardi 10 février au vendredi 3 avril</u>, en raison de travaux av de Clermont, l'arrêt <strong>Emile Coulaudon </strong>direction Lycée Lafayette sera reporté sur 1 arrêt provisoire situé 25 mètres après le rond-point.</p>\",\"start_datetime\":\"2026-02-06T15:10:12.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"23\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-06T15:15:03.022Z\",\"updated_at\":\"2026-03-09T09:07:54.000Z\"},{\"id\":\"1.32094.2\",\"type\":\"Trafic\",\"title\":\"Ligne S15\",\"text\":\"<p>Le réseau s'adapte pour une meilleure performance. Les bus de la ligne S15 effectueront leur terminus à l'arrêt AUBIERE Quartier Chambon de la ligne S10 <u>à compter du mardi 27 janvier 2026 :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Roussillon, Gustave Flaubert, Patinoire et Lycée La Fayette</strong> ne seront pas desservis en direction de Lycée La Fayette du lundi au samedi.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Lycée La Fayette, Patinoire et Gustave Flaubert </strong>ne seront pas desservis en direction de COURNON Plan d'eau du lundi au samedi.</li></ol><p><br></p><p><strong><u>Important :</u></strong></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Pour rejoindre l'arrêt Lycée La Fayette, vous pouvez emprunter la ligne C depuis l'arrêt Pont de Sarliève.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Pour rejoindre l'arrêt Lycée Gustave Flaubert, vous pouvez emprunter la ligne S10.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Pour rejoindre l'arrêt Roussillon, vous pouvez emprunter la ligne S10 depuis l'arrêt AUBIERE Quartier Chambon ou vous pouvez vous reporter à l'arrêt Chazots de la ligne S15.</li></ol><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Pour consulter le plan de la ligne S15 valable pendant la déviation, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/T2C_Plan%20S15%20-%20janv2026.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u></p>\",\"start_datetime\":\"2026-01-23T09:07:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"23\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-01-23T09:07:02.126Z\",\"updated_at\":\"2026-01-31T09:51:07.000Z\"},{\"id\":\"1.21903.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Alice Milliat reporté jusqu'au 29 mai 2026\",\"text\":\"<p>En raison de travaux, l'arrêt <strong>Alice Milliat</strong> en direction de Lycée La Fayette est reporté sur l'arrêt Av. de l'Allier, situé avenue de l'Allier, jusqu'au <u>vendredi 29 mai 2026</u>.</p>\",\"start_datetime\":\"2025-12-19T05:50:15.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"23\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T05:53:02.105Z\",\"updated_at\":\"2026-02-25T14:28:44.000Z\"},{\"id\":\"1.32202.2\",\"type\":\"Trafic\",\"title\":\"Déviation du 23 février au 27 mars 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne P31 seront déviés dans les deux sens <u>du lundi 23 février au vendredi 27 mars 2026</u> :</p><p><u>Direction CEYRAT Arténium :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts <strong>Résistance</strong>, <strong>Bernard Maître </strong>et <strong>Champ Madame</strong> seront reportés sur les arrêts Résistance de la ligne S12 direction BEAUMONT Pl. d'Armes.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts<strong> Chapelle de l'Agneau</strong>,<strong> Stade de l'Artière </strong>et<strong> Prés Hauts </strong>seront reportés sur les arrêts Chaussades.</li></ol><p><u>Direction BEAUMONT Collège Molière :</u></p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts <strong>Bernard Maître </strong>et <strong>Champ Madame</strong> seront reportés sur les arrêts BEAUMONT Pl. d'Armes.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>les arrêts<strong> Stade de l'Artière </strong>et<strong> Prés Hauts </strong>seront reportés sur les arrêts Les Roches.</li></ol><p><span style=\\\"color: rgb(26, 27, 31);\\\">Pour consulter le plan de la ligne P31 pendant ces travaux, cliquez </span><u style=\\\"color: inherit;\\\"><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-01/SMTC_T2C_PL_P31_100pct_dec2025_v03.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">ici</a></u><span style=\\\"color: rgb(26, 27, 31);\\\">.</span></p>\",\"start_datetime\":\"2026-02-16T08:38:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"42\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-02-16T08:47:02.404Z\",\"updated_at\":\"2026-02-18T15:49:36.000Z\"},{\"id\":\"1.21919.14\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne P33 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction Champratel seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Champcros </strong>et <strong>Debussy</strong> direction CHATEAUGAY Malalittes seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Coutils </strong>seront reportés dans les 2 sens sur des arrêts provisoires* situés avenue du 8 Mai, à hauteur du carrefour avec la rue et la Route de Gerzat.</li></ol><p><span style=\\\"color: rgb(255, 255, 255);\\\"> </span><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"31\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.32272.2\",\"type\":\"Trafic\",\"title\":\"Déviation ligne P34\",\"text\":\"<p>En raison de travaux, les bus de la ligne P34 seront déviés dans les deux sens <u>du lundi 16 au vendredi 20 mars </u>: </p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>l'arrêt <strong>Victor Charreton</strong> en direction des Côtes sera reporté sur l'arrêt de descente Trémonteix Paul Eychart de la ligne E4, situé pl. Paul Eychart.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>l'arrêt <strong>Victor Charreton</strong> en direction de Tillon sera reporté sur le terminus Paul Eychart de la ligne E4 situé rue Jean Monnet.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Jacques Brel</strong> seront reportés sur les arrêts Trémonteix Charcot de la ligne E4, situés rue Jean Monnet. </li></ol>\",\"start_datetime\":\"2026-03-09T09:20:48.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"7\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-10T10:58:03.005Z\",\"updated_at\":\"2026-03-10T10:57:24.000Z\"},{\"id\":\"1.32255.2\",\"type\":\"Trafic\",\"title\":\"Arrêt Lac direction Le Cendre Pandières reporté définitivement\",\"text\":\"<p>L'arrêt <strong>Lac </strong>direction Le Cendre Pandières sera reporté définitivement <u>à compter du mardi 3 mars 2026</u> sur l'arrêt Dômes, situé avenue G. Clémenceau.</p>\",\"start_datetime\":\"2026-03-02T07:58:46.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"34\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-02T08:01:02.685Z\",\"updated_at\":\"2026-03-02T08:00:58.000Z\"},{\"id\":\"1.21919.2\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne P37 seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Coutils</strong>,<strong> Champcros </strong>et <strong>Debussy</strong> direction Champratel/Gare SNCF seront reportés sur un arrêt provisoire<strong>*</strong> situé rue de Dunkerque, face à La Poste.</li><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts<strong> Coutils</strong>,<strong> Champcros </strong>et <strong>Debussy</strong> direction GERZAT Donnavignat seront reportés sur un arrêt provisoire<strong>*</strong> situé face au n° 14 rue de Chancrole.</li></ol><p><strong style=\\\"color: rgb(255, 255, 255);\\\">*</strong><span style=\\\"color: rgb(255, 255, 255);\\\">Arrêts provisoires non accessibles aux personnes à mobilité réduite</span></p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"28\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.21927.2\",\"type\":\"Trafic\",\"title\":\"Ligne BEN déviée jusqu'au 7 juin 2026\",\"text\":\"<p>En raison de travaux, les bus BEN sont déviés jusqu'au <u>samedi 7 juin 2026</u> :</p><ol><li data-list=\\\"bullet\\\"><span class=\\\"ql-ui\\\" contenteditable=\\\"false\\\"></span>Les arrêts <strong>Résidence Pasteur </strong>et<strong> Cité 1</strong> sont reportés sur l’arrêt de substitution Cézeaux Pellez* de la ligne A direction La Pardieu Gare, situé situé avenue Blaise Pascal, au niveau de la station tram.</li></ol><p><br></p><p><strong>* </strong>Arrêt non accessible aux personnes à mobilité réduite</p>\",\"start_datetime\":\"2025-12-20T04:31:30.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L34\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-20T04:37:01.947Z\",\"updated_at\":\"2025-12-22T09:17:44.000Z\"},{\"id\":\"1.32260.2\",\"type\":\"Trafic\",\"title\":\"Ligne 110 - Collège Anatole France\",\"text\":\"<p><u>À compter du lundi 9 mars</u>, le départ de 7h27 de l’arrêt <strong>BLANZAT Fradière</strong> en direction du collège Anatole France, sera réalisé depuis l'arrêt Fradière de la ligne S13 direction Champratel, situé place de la Poste.</p><p><br></p><p><a href=\\\"https://cms.t2c.fr/sites/default/files/2026-03/Collège%20Anatole%20France.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">Consultez la fiche horaires valable à compter du lundi 9 mars</a></p>\",\"start_datetime\":\"2026-03-05T07:31:14.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L36\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2026-03-05T07:32:02.287Z\",\"updated_at\":\"2026-03-09T05:35:46.000Z\"},{\"id\":\"1.21919.5\",\"type\":\"Trafic\",\"title\":\"Travaux avenue de la République à Cébazat jusqu'au 18 décembre 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne scolaire 110 pour le collège Anatole France seront déviés dans les deux sens jusqu'au <u>vendredi 18 décembre 2026</u>.</p><p>Les arrêts Coutils, Champcros et Debussy sont reportés sur un poteau provisoire* situé au niveau du n° 51 avenue de la République.</p><p>*Arrêts provisoires non accessibles aux personnes à mobilité réduite</p>\",\"start_datetime\":\"2025-12-20T11:00:00.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L36\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-03-11T09:32:26.000Z\"},{\"id\":\"1.21916.2\",\"type\":\"Trafic\",\"title\":\"Déviation des services scolaires S160 du 5 janvier au 3 avril 2026\",\"text\":\"<p>En raison de travaux, les bus de la ligne scolaire BEAUMONT Chemin de Sou - Collège Molière (S160) et Collège Molière - BEAUMONT Matharet (S160) seront déviés <u>jusqu'au vendredi 3 avril 2026. </u></p><p><a href=\\\"https://api.t2c.fr/sites/default/files/2026-01/Servicesscolaires_Moliere.pdf\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">Consultez la nouvelle feuille de route de la ligne</a></p>\",\"start_datetime\":\"2025-12-19T08:02:57.000Z\",\"end_datetime\":\"9999-12-31T22:59:59.000Z\",\"priority\":1,\"affected_routes\":[\"L41\"],\"disruption_level\":\"moderate\",\"forwarding\":null,\"created_at\":\"2025-12-19T09:28:06.043Z\",\"updated_at\":\"2026-01-28T12:25:28.000Z\"}]"},"redirectURL":"","headersSize":566,"bodySize":4887,"_status":"completed","_startTimestamp":1773840389510233,"_endTimestamp":1773840389513525},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAdd